# Copy to .env.local and fill in real values. Never commit secrets.

# Neon / PostgreSQL connection string (server-side only)
# Used by the Next.js app, Drizzle Kit, and most tests — typically development.
DATABASE_URL=

# Optional explicit development URL for promotion safety checks.
# If unset, promotion treats DATABASE_URL as the development database.
# DEVELOPMENT_DATABASE_URL=

# QA → Production content promotion (CLI only: npm run promote:qa)
# Never reuse DATABASE_URL here. These must be dedicated QA and Production URLs.
# QA_DATABASE_URL=
# PRODUCTION_DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Optional in local dev; required in some deployments so Auth.js
# knows the canonical app URL (e.g. https://example.com)
# AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional bootstrap: if set, and no superadmin exists yet, the matching
# Google account is created as superadmin on first sign-in.
# Prefer scripts/promote-superadmin.ts for explicit production setup.
# INITIAL_SUPERADMIN_EMAIL=
